{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@coinche-reborn/api": "workspace:*",
    "@coinche-reborn/auth": "workspace:*",
    "@coinche-reborn/db": "workspace:*",
    "@coinche-reborn/env": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "winston": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@coinche-reborn/config": "workspace:*",
    "@types/bun": "^1.3.14",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  }
}
