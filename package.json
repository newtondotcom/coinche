{
  "name": "coinche-reborn",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.13.2",
      "@orpc/server": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "^1.6.29",
      "@orpc/client": "^1.15.0"
    }
  },
  "type": "module",
  "scripts": {
    "check": "oxlint && oxfmt --write",
    "ruler:apply": "bunx @intellectronica/ruler@latest apply --local-only",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @coinche-reborn/db db:push",
    "db:studio": "turbo -F @coinche-reborn/db db:studio",
    "db:generate": "turbo -F @coinche-reborn/db db:generate",
    "db:migrate": "turbo -F @coinche-reborn/db db:migrate",
    "db:start": "turbo -F @coinche-reborn/db db:start",
    "db:watch": "turbo -F @coinche-reborn/db db:watch",
    "db:stop": "turbo -F @coinche-reborn/db db:stop",
    "db:down": "turbo -F @coinche-reborn/db db:down",
    "compile:server": "turbo -F server compile",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@coinche-reborn/env": "workspace:*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@coinche-reborn/config": "workspace:*",
    "@types/bun": "^1.3.14",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "shadcn": "^4.18.0",
    "turbo": "^2.10.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.2"
}
